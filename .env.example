# Application
APP_NAME=nvd-mirror
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
API_HOST_PORT=8000
NVD_MIRROR_IMAGE=nvd-mirror:local

# PostgreSQL
POSTGRES_DB=nvd
POSTGRES_USER=nvd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=54329
DATABASE_URL=postgresql+psycopg://nvd:change-me@postgres:5432/nvd

# NVD JSON 2.0 feeds. NVD_FEED_UPSTREAM_BASE_URL overrides
# NVD_MIRROR_BASE_URL when it is non-empty.
NVD_MIRROR_BASE_URL=https://nvd.nist.gov/feeds/json/cve/2.0
NVD_FEED_UPSTREAM_BASE_URL=
NVD_FEED_SOURCE_MODE=managed
NVD_FEED_MIRROR_DIR=/data/mirror/nvd

# Lightweight live NVD API total checks used by the read-only dashboard.
NVD_API_CVES_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_CPES_URL=https://services.nvd.nist.gov/rest/json/cpes/2.0
NVD_API_KEY=
LIVE_NVD_TOTAL_CACHE_TTL_SECONDS=300
DASHBOARD_STATS_CACHE_SECONDS=600

# Upstream request pacing and retry behavior.
NVD_UPSTREAM_REQUEST_DELAY_SECONDS=6
NVD_UPSTREAM_RETRIES=10
NVD_UPSTREAM_RETRY_BACKOFF_SECONDS=15
NVD_DOWNLOAD_PROGRESS_INTERVAL_BYTES=52428800
NVD_USER_AGENT=
REQUEST_TIMEOUT_SECONDS=900

# Import/query behavior
DEFAULT_FROM_YEAR=2002
MAX_RESULTS_PER_PAGE=2000
VALIDATE_META=true
VALIDATE_GZ_SIZE=true
VALIDATE_UNCOMPRESSED_SIZE=true
VALIDATE_UNCOMPRESSED_SHA256=true

# Upstream TLS verification.
UPSTREAM_VERIFY_TLS=true
UPSTREAM_CA_BUNDLE=

# Optional application-level TLS.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Built-in scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_STARTUP=modified
SCHEDULER_MAX_SLEEP_SECONDS=60
NVD_SYNC_TIMEZONE=America/New_York
NVD_SYNC_MODIFIED_ENABLED=true
NVD_SYNC_MODIFIED_EVERY_HOURS=1
NVD_SYNC_MODIFIED_MINUTE=25
NVD_SYNC_DAILY_MIRROR_ENABLED=true
NVD_SYNC_DAILY_MIRROR_HOUR=3
NVD_SYNC_DAILY_MIRROR_MINUTE=15
NVD_SYNC_DAILY_MIRROR_FORCE=false
